# Frontend / App Environment Variables

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_APP_URL=http://localhost:5173

# Edge Functions / Backend Context
# Use supabase secrets set <KEY=VALUE> to deploy these to your production Edge Functions

SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
OPENAI_API_KEY=your_openai_api_key_here

# SMS configuration (Termii, Twilio, etc)
SMS_API_URL=your_sms_provider_url_here
SMS_API_KEY=your_sms_provider_api_key_here
